{
  "name": "thaicutcut",
  "productName": "ThaiCutCut",
  "version": "1.0.0",
  "description": "ThaiCutCut, a video editor based on OpenCut",
  "author": "thaipro.store",
  "homepage": "https://thaipro.store/phan-mem/thaicutcut",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "pack:win": "electron-builder --win --x64",
    "pack:mac": "electron-builder --mac --universal"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "store.thaipro.thaicutcut",
    "productName": "ThaiCutCut",
    "copyright": "Based on OpenCut, Copyright 2025-2026 OpenCut (MIT). ThaiCutCut by thaipro.store.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web",
        "to": "web"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "asar": true,
    "electronLanguages": [
      "en-US",
      "vi"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${name}-${version}-windows-x64-portable.${ext}"
    },
    "nsis": {
      "artifactName": "${name}-${version}-windows-x64-setup.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "ThaiCutCut",
      "deleteAppDataOnUninstall": false,
      "license": "build/license.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1066"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "${name}-${version}-macos-universal.${ext}",
      "title": "ThaiCutCut ${version}"
    }
  }
}
